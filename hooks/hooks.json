{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "FRW_BOOTSTRAP_QUIET=1 \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\" || true",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
